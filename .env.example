# =============================================================================
# ShaloTrack Fleet Portal — LOCAL DEVELOPMENT template
#
#   cp .env.example .env && php artisan key:generate
#
# Production does NOT use a .env file. Production values are injected as
# container environment variables (secrets from AWS SSM). Never commit .env.
# =============================================================================

APP_NAME="ShaloTrack Fleet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error pages always show the real error category + a reference ID that matches the log.
# true  = also show the exact message and file:line (LOCAL DEVELOPMENT / staging only).
# false = what customers see in production (the Dockerfile default); read the details in the log.
ERROR_PAGE_DETAILS=true

# This portal has NO database of its own — all data goes through the C# API.
DB_CONNECTION=sqlite

# Sessions/cache on local disk; queue runs inline. No database needed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Must differ from the Admin portal's cookie name (both are on *.shalotrack.com).
SESSION_COOKIE=shalotrack_fleet_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# ---- ShaloTrack C# API ------------------------------------------------------
# Point this at a LOCAL or STAGING API. Never at production from a dev machine.
# Production sets it in the container environment (https:// is enforced there).
SHALOTRACK_API_BASE_URL=http://localhost:5000
SHALOTRACK_API_TIMEOUT=10
# Seconds to wait for the API to accept the connection (a dead API then frees the PHP worker in 3 s).
SHALOTRACK_API_CONNECT_TIMEOUT=3
# Live-tracking hub. Leave unset: it is derived from SHALOTRACK_API_BASE_URL (<api>/hubs/location).
# SHALOTRACK_SIGNALR_HUB_URL=

# ---- Firebase (web config — public by design, restricted by HTTP referrer) --
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ---- Google Maps JS API (restrict by HTTP referrer in Google Cloud) ---------
GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"